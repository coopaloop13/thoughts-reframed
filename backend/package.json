{
  "name": "reframed-thoughts-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "schema:export": "tsx scripts/export-schema.ts",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "voice:start": "scripts/voice-pod.sh start",
    "voice:stop": "scripts/voice-pod.sh stop",
    "voice:status": "scripts/voice-pod.sh status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@pothos/core": "^4.15.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.4.0",
    "graphql-yoga": "^5.24.4",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@electric-sql/pglite": "^0.5.9",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "msw": "^2.15.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
